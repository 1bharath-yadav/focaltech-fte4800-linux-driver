post_install() {
  dkms install --no-depmod "$pkgname/$pkgver" || true
  depmod -a || true
  udevadm control --reload-rules || true
  udevadm trigger --subsystem-match=misc || true
}

post_upgrade() {
  post_install
}

pre_remove() {
  dkms remove "$pkgname/$pkgver" --all || true
  depmod -a || true
}
