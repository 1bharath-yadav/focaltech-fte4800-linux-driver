#!/usr/bin/env bash
# Omarchy FTE4800 setup wrapper.
# Uses the native project libfprint when present and delegates to stock Omarchy
# for hardware families we do not own.
set -euo pipefail

NATIVE_LIB="/opt/fte4800/libfprint/lib/libfprint-2.so.2.0.0"
NATIVE_DROPIN="/etc/systemd/system/fprintd.service.d/00-native-fte4800.conf"
PROJECT_ROOT="/home/archer/projects/zerobook-focaltech-driver/.worktrees/fte4800-clean-driver"
SYSTEM_SETUP="/usr/bin/omarchy-setup-security-fingerprint"
DETECTOR="$PROJECT_ROOT/install/omarchy-hw-fingerprint-fte4800"

native_fte4800_ready() {
  [[ -s "$NATIVE_LIB" && -f "$NATIVE_DROPIN" ]] || return 1
  grep -q 'LD_LIBRARY_PATH=/opt/fte4800/libfprint/lib' "$NATIVE_DROPIN"
}

if ! native_fte4800_ready; then
  exec "$SYSTEM_SETUP" "$@"
fi

echo "FTE4800 native libfprint detected; preserving /opt/fte4800 deployment."
if ! bash "$DETECTOR"; then
  echo "No supported fingerprint reader detected." >&2
  exit 1
fi

install_packages=()
omarchy-pkg-missing fprintd || install_packages+=(fprintd)
omarchy-pkg-missing usbutils || install_packages+=(usbutils)
if (${#install_packages[@]}); then
  echo "Installing required authentication packages: ${install_packages[*]}"
  sudo pacman -S --needed --noconfirm "${install_packages[@]}"
fi

echo
if fprintd-list "$USER" 2>/dev/null | grep -q '^ - #[0-9]'; then
  echo "Existing fingerprint enrollment found; skipping re-enrollment."
else
  echo "No enrollment found. Enroll a finger now."
  sudo fprintd-enroll "$USER"
fi

echo
echo "Verify the enrolled finger."
fprintd-verify

echo
echo "Applying Omarchy PAM/lock integration."
sudo "$PROJECT_ROOT/install/omarchy-fte4800-root-install.sh"

echo
echo "FTE4800 fingerprint authentication configured for sudo, polkit, and Omarchy lock screen."
