+#define FTE4800_RAW_PIXELS     (FTE4800_RAW_WIDTH * FTE4800_RAW_HEIGHT) /* 5120 */
+
+#define FTE4800_SCALED_WIDTH   (FTE4800_RAW_WIDTH * 2)  /* 128 */
+#define FTE4800_SCALED_HEIGHT  (FTE4800_RAW_HEIGHT * 2) /* 160 */
